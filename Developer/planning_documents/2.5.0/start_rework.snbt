	quests: [
		{
			description: [
				"妈的, 烧的真他妈充分."
				"要不是紧急逃生仓, 我怕是也和这船体一样支离破碎了."
				"这里是&b伊甸&r, 一颗刚被确认可居住的&6新星系行星&r. 我是被派来的开拓工程师之一, 任务是把整套&e自动化开拓设备&r铺开, 让后续的殖民船落地就能开工."
				"可它们在坠毁里全没了. 图纸还在我脑子里, 工具却得一件件重新做."
				"空气含氧量34%, 地表重力加速度10.28m*s^-2, 有地球生物存活... 既然这样, 得赶紧想办法活下去, 才能争取与地球的通讯..."
			]
			id: "7E5C1B2C00000001"
			shape: "gear"
			size: 1.8d
			subtitle: "紧急求助!紧急求助!"
			tasks: [{
				id: "7E5C5B2C00000101"
				item: "minecraft:cooked_beef"
				type: "item"
			}]
			title: "劫后余生"
			x: -10.0d
			y: 14.0d
		}
		{
			dependencies: ["7E5C1B2C00000001"]
			description: [
				"在星球地层里发现了一种特殊的晶体矿物"
				"它的表面上一直浮动着奇怪的光辉, 似乎蕴含着能量"
				"手上暂时没有什么鉴定材料, 但是我有一种直觉, 我可以用特殊的结构把它的能量激发出来"
				"我需要给这种用于激发晶体能量的结构起一个名字"
				"就叫...构件吧"
			]
			id: "7E5C1B2C00000002"
			subtitle: "当一种矿物发光时, 你最好祈祷它也在发热"
			tasks: [{
				id: "7E5C5B2C00000201"
				item: "cmi:dreamcore_ore"
				type: "item"
			}]
			title: "梦幻般的晶体"
			x: -10.0d
			y: 11.0d
		}
		{
			dependencies: ["7E5C1B2C00000002"]
			description: [
				"把随处可见的材料敲打成型, 就是最基础的构件零件"
				"既然自动化设备丢了, 那就用最原始的方式把产线重新拼出来 —— 这些不起眼的零件就是第一块砖"
			]
			id: "7E5C1B2C00000003"
			tasks: [{
				id: "7E5C5B2C00000301"
