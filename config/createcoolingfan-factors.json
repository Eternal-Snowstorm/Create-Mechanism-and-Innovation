{
  // ============================================================
  // Create Cooling Fan —— 风扇处理系数
  // ============================================================
  //
  // 风扇的气流经过铸造台 / 铸造盆时，按下面的系数加速或减慢冷却：
  //
  //     每 tick 进度增量 = sqrt(气流强度 / 64) * 系数
  //
  //   系数 > 0 ： 加速冷却
  //   系数 < 0 ： 减慢冷却
  //   系数 = 0 ： 该处理类型完全不受气流影响
  //
  //   送风与吸风的效果相同，方向不参与计算，只按气流强度算。
  //   绝对值越大影响越强；气流越强影响越强（按平方根增长）。
  //   气流强度为 64 时，系数 1 相当于每 tick 推进 1 tick 的冷却。
  //   负数系数让冷却变慢；每 tick 的负增量达到 1 时会完全停住（不会倒退）。
  //
  // 本文件支持 // 与 /* */ 注释，可以自由添加自己的说明。
  // 模组只在发现新的处理类型时向文件末尾追加条目，
  // 不会重写、也不会删除你写的任何内容。
  //
  // 未在下面列出的处理类型，使用服务端配置里的 defaultFactor。
  // 本文件是全局的；单人游戏里 defaultFactor 存在世界存档的 serverconfig 中。
  // ============================================================
  // ---- Create 内置处理类型 ----
  "create:splashing": 1,   // 洗涤：风扇后方放水
  "create:haunting": 0.5,   // 缠魂：风扇后方放灵魂火
  "create:smoking": -0.3,   // 烟熏：风扇后方放火
  "create:blasting": -0.5,   // 鼓风：风扇后方放岩浆

  // ---- 其它模组注册的处理类型 ----
  "create_dragons_plus:sanding": 0.5,
  "create_dragons_plus:freezing": 0.5,
  "create_dragons_plus:coloring_white": 0.5,
  "create_dragons_plus:coloring_light_gray": 0.5,
  "create_dragons_plus:coloring_gray": 0.5,
  "create_dragons_plus:coloring_black": 0.5,
  "create_dragons_plus:coloring_brown": 0.5,
  "create_dragons_plus:coloring_red": 0.5,
  "create_dragons_plus:coloring_orange": 0.5,
  "create_dragons_plus:coloring_yellow": 0.5,
  "create_dragons_plus:coloring_lime": 0.5,
  "create_dragons_plus:coloring_green": 0.5,
  "create_dragons_plus:coloring_cyan": 0.5,
  "create_dragons_plus:coloring_light_blue": 0.5,
  "create_dragons_plus:coloring_blue": 0.5,
  "create_dragons_plus:coloring_purple": 0.5,
  "create_dragons_plus:coloring_magenta": 0.5,
  "create_dragons_plus:coloring_pink": 0.5,
  "cmi:freezing": 2,
  "fluidlogistics:bulk_cooling": 0.5,
  "create_dragons_plus:ending": 0.5,
  "fluidlogistics:inactive_bulk_cooling": 0.5
}
